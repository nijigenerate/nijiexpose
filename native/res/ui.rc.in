#include <windows.h>
1 ICON "@PROJECT_SOURCE_DIR@/native/res/icon.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "nijigenerate Project\0"
            VALUE "FileDescription", "nijiexpose\0"
            VALUE "FileVersion", "@NIJIEXPOSE_VERSION_CPP@\0"
            VALUE "InternalName", "nijiexpose\0"
            VALUE "OriginalFilename", "nijiexpose.exe\0"
            VALUE "ProductName", "nijiexpose\0"
            VALUE "ProductVersion", "@NIJIEXPOSE_VERSION_CPP@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

