set(script "${NIJITRACK_SOURCE}/native/scripts/build_mediapipe_halide.sh")
file(READ "${script}" content)
if(content MATCHES "NIJIEXPOSE_BAZEL_CACHE")
    return()
endif()
file(SHA256 "${script}" actual)
if(NOT actual STREQUAL "e5bfa884b57031aae34480de92d7023d5e9956a981befbfb0928820f134ef494")
    message(FATAL_ERROR "Unknown nijitrack Linux build recipe; rebase the cache patch")
endif()
string(REPLACE "--compilation_mode=opt --jobs=4" "--compilation_mode=opt --jobs=4 --disk_cache=\"$NIJIEXPOSE_BAZEL_CACHE\"" content "${content}")
file(WRITE "${script}" "${content}")
