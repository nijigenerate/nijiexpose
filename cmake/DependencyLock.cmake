include_guard(GLOBAL)
set(NIJIEXPOSE_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NIJIEXPOSE_CMAKE_DIR}/dependencies.lock.json")
endif()
function(nijiexpose_dependency name)
    file(READ "${NIJIEXPOSE_CMAKE_DIR}/dependencies.lock.json" lock)
    string(JSON url GET "${lock}" "${name}" url)
    string(JSON hash GET "${lock}" "${name}" sha256)
    string(JSON archive ERROR_VARIABLE no_vendor GET "${lock}" "${name}" vendor)
    if(NOT no_vendor)
        set(url "${NIJIEXPOSE_CMAKE_DIR}/../vendor/${archive}")
    endif()
    set(dependency_url "${url}" PARENT_SCOPE)
    set(dependency_hash "${hash}" PARENT_SCOPE)
endfunction()
